# Copy to .env. Never commit .env: it holds your domain, NAS address and secrets.

# Host port for the MCP endpoint (http://<host>:<port>/mcp)
HOME_BRAIN_PORT=8000

# --- server-docker-compose.yml only ----------------------------------------

# Public HTTPS address served by the Cloudflare Tunnel (no trailing slash)
PUBLIC_URL=https://brain.example.com

# GitHub OAuth App (Settings > Developer settings > OAuth Apps)
# Callback URL: <PUBLIC_URL>/auth/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# GitHub accounts allowed to use the server, comma-separated. Use numeric user IDs (the "id" at
# https://api.github.com/users/<login>): a login can be renamed and then registered by someone else.
# Logins still work, with a warning in the log.
ALLOWED_USERS=your-github-user-id

# NFS export of the vault dataset on the NAS
NAS_ADDRESS=192.168.1.10
NAS_VAULT_EXPORT=/mnt/tank/home-brain/vault
# 3 works everywhere; 4.1 only if NFSv4 is enabled on the NAS
NAS_NFS_VERSION=3

# UID/GID that owns the vault dataset on the NAS
HOME_BRAIN_UID=1000
HOME_BRAIN_GID=1000

# --- Push notifications (ntfy) ---------------------------------------------

# Public HTTPS address of ntfy for the phone app, served by the Cloudflare Tunnel
NTFY_PUBLIC_URL=https://ntfy.example.com
# Where home-brain publishes: the ntfy container. Leave empty to turn notifications off.
NTFY_URL=http://ntfy
NTFY_TOPIC=home-brain
# Token of the ntfy user home-brain publishes as (docs/deploy.md, step 6)
NTFY_TOKEN=
# When the evening briefing about tomorrow is sent
BRIEFING_TIME=19:00
# Language of the pushed messages: en (English) or nb (Norwegian Bokmål)
NOTIFY_LANGUAGE=en

# --- Chores from Home-Board (optional) -------------------------------------

# Home-Board's API on the proxy network, e.g. http://home-board-api:8080; empty = no chores
HOMEBOARD_URL=
# The same key as Home-Board's Integrations__ApiKey (docs/deploy.md, step 7)
HOMEBOARD_API_KEY=
# Optional: the same key as Home-Board's Integrations__WriteApiKey, so Claude can approve chores
# and give bonus points; empty = read-only
HOMEBOARD_WRITE_KEY=

# --- Calendar events (optional) --------------------------------------------

# Secret iCal addresses of calendars whose events join the agenda and the briefings, separated
# by spaces or commas; e.g. Google Calendar's "Secret address in iCal format" (docs/deploy.md,
# step 8). Anyone with the address can read the calendar, so treat it like a password.
CALENDAR_URLS=
