# Copy to .env. Never commit .env: it holds your domain, NAS address and secrets.

# Host port for the MCP endpoint (http://<host>:<port>/mcp)
HOME_BRAIN_PORT=8000

# --- server-docker-compose.yml only ----------------------------------------

# Public HTTPS address served by the Cloudflare Tunnel (no trailing slash)
PUBLIC_URL=https://brain.example.com

# GitHub OAuth App (Settings > Developer settings > OAuth Apps)
# Callback URL: <PUBLIC_URL>/auth/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# GitHub logins allowed to use the server, comma-separated
ALLOWED_USERS=your-github-login

# NFS export of the vault dataset on the NAS
NAS_ADDRESS=192.168.1.10
NAS_VAULT_EXPORT=/mnt/tank/home-brain/vault
# 3 works everywhere; 4.1 only if NFSv4 is enabled on the NAS
NAS_NFS_VERSION=3

# UID/GID that owns the vault dataset on the NAS
HOME_BRAIN_UID=1000
HOME_BRAIN_GID=1000
